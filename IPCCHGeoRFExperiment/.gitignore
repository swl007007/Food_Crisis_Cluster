__pycache__/

# Run outputs stay out of git, with the evidence that supports a reported claim
# carved back in. The FEWS NET completion audit returned "incomplete" purely because
# the ledgers were on disk but not in the commit, so the auditor's independent clone
# could not see them; this package does not repeat that.
#
# Included for the ablation cells (~38 MB): manifests with the cohort filter and the
# split-gate readback, Stage 1 gates and area assignments, and every reported metric
# with its bootstrap draws. Excluded: the extracted baseline, geography, feature
# matrices and per-row Stage 3 predictions, all reproducible from the pinned source.
runs/*
!runs/*/
runs/*/*
!runs/*/manifest.json
!runs/*/run.log
!runs/*/data/
!runs/*/stage1/
!runs/*/reports/

runs/*/data/*
!runs/*/data/cohort_filter.json
!runs/*/data/target_gate.json

runs/*/stage1/*
!runs/*/stage1/*.json
!runs/*/stage1/area_assignments.csv
# R6: the candidate-evaluation transcripts check_cells.py parses. 12 MB each raw,
# ~0.1 MB gzipped; without them the committed checker exits 1 in a fresh clone.
!runs/*/stage1/georf_fit_stdout.txt.gz

# The per-row predictions the same-key reference is computed from, for both the
# ablation cells and the prior baseline they are compared against. ~10 MB total.
!runs/*/stage3/
runs/*/stage3/*
!runs/*/stage3/predictions.csv.gz
!runs/*/stage3/*.json

# The valid target ledger that defines persistence availability, and the prior run's
# cohort keys - needed to reconcile the evaluation cohort independently.
!runs/*/data/target_ledger_valid.csv.gz

runs/*/reports/*
!runs/*/reports/*.json
!runs/*/reports/*/
runs/*/reports/*/*
!runs/*/reports/*/*.json
!runs/*/reports/*/*.csv
