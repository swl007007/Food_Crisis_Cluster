__pycache__/

# The frozen inventories are the implementation contract. The repository root
# ignores *.json wholesale, and a deeper .gitignore wins, so carve them back in
# here: a reviewer who cannot read config/ cannot check a single feature name.
!config/*.json

# The root ignores test_* wholesale. The contract tests are the evidence that
# the history formulas are right; a reviewer who cannot read them is reviewing
# the implementation against itself.
!test_contracts.py

# --------------------------------------------------------------------------
# Run outputs: local by default, with the evidence a reported number rests on
# carved back in. The rule of thumb is that an independent clone must be able
# to recompute every published figure without the 731 MB feature matrix.
#
# Included (~55 MB): the manifests, the fold calendar with its support counts,
# every per-fold score and route, the selection ledger, the freeze, both
# replays and the full report. Excluded: rich561_X.npy (731 MB, hash-bound in
# freeze.json and rebuildable by prepare_data.py from the pinned source), the
# full unfiltered target ledger, the extracted baseline copy of an already
# tracked release, and the replay's duplicate report tree -- report_replay.json
# already records that the two agreed file by file.
# --------------------------------------------------------------------------
runs/*
!runs/*/

runs/*/*
!runs/*/manifest.json
!runs/*/freeze.json
!runs/*/stage_*.json
!runs/*/run.log
!runs/*/inputs/
!runs/*/data/
!runs/*/folds/
!runs/*/development/
!runs/*/main/
!runs/*/validation/
!runs/*/reports/

runs/*/data/*
!runs/*/data/keys.csv.gz
!runs/*/data/history_source_keys.csv.gz
!runs/*/data/target_ledger_valid.csv.gz
!runs/*/data/country_lookup.csv.gz
!runs/*/data/feature_schema.csv
!runs/*/data/feature_audit.json

runs/*/development/*
!runs/*/development/selection_ledger.csv
!runs/*/development/folds/

# The retained estimators are 533 MB. Their identity records -- digest,
# get_params() readback, booster config, round count and the digest of the
# ordered fitting keys they were built from -- are committed in full, along
# with the binaries for the first main fold at each horizon (19 MB) so a
# reviewer can actually exercise prediction-only replay. --stage persist
# regenerates the rest and proves they reproduce every stored prediction.
runs/*/main/*
!runs/*/main/folds/
!runs/*/main/model_identity/
!runs/*/main/models/
runs/*/main/models/*
!runs/*/main/models/mai_h01_2023-02__*
!runs/*/main/models/mai_h03_2023-04__*
!runs/*/main/models/mai_h06_2023-07__*
!runs/*/main/models/mai_h12_2024-01__*
!runs/*/main/model_identity/*.json

# The refit predictions exist only to be compared against main/folds; the
# comparison itself is committed in validation/model_persistence.json.
runs/*/main_refit/

runs/*/validation/*
!runs/*/validation/replay.json
!runs/*/validation/report_replay.json
!runs/*/validation/model_persistence.json
!runs/*/validation/model_replay.json
!runs/*/validation/folds/
!runs/*/validation/freeze_replay/
runs/*/validation/freeze_replay/*
!runs/*/validation/freeze_replay/*.json
!runs/*/validation/freeze_replay/*.csv

# The repository root ignores *.csv and *.json outright. Re-including a
# directory is not enough: every evidence file under it has to be named back
# in, or the per-fold routes, the metric tables and the verdicts all vanish
# from the commit while looking present on disk.
!runs/*/inputs/*.json
!runs/*/data/*.json
!runs/*/folds/*.csv
!runs/*/development/folds/*.json
!runs/*/development/*.csv
!runs/*/main/folds/*.json
!runs/*/validation/folds/*.json
!runs/*/reports/*.json
!runs/*/reports/*.csv
